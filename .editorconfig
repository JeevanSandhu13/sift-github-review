root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi,ps1}]
indent_style = space
indent_size = 4

[*.{js,css,html,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{md,R,ado,do}]
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
